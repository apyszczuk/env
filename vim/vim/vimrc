function! s:find_selected_tag(cmd)
    try
        let default_input           = get(g:, "ctrlp_default_input", "")
        let g:ctrlp_default_input   = getline("'<")[getpos("'<")[2]-1:getpos("'>")[2]-1]
        execute a:cmd
    finally
        if exists("default_input")
            let g:ctrlp_default_input = default_input
        endif
    endtry
endfunction

