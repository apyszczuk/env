" ---- WINDOW VIEW -----------------------------------------------------------------------
function! s:save_window_view()
    if !exists("w:buffer_view")
        let w:buffer_view = {}
    endif
    let w:buffer_view[bufnr("%")] = winsaveview()
endfunction

function! s:restore_window_view()
    let buf = bufnr("%")
    if exists("w:buffer_view") && has_key(w:buffer_view, buf)
        let v = winsaveview()
        let is_file_begin = v.lnum == 1 && v.col == 0
        if is_file_begin && !&diff
            call winrestview(w:buffer_view[buf])
        endif
        unlet w:buffer_view[buf]
    endif
endfunction

if v:version >= 700
    autocmd BufLeave * call s:save_window_view()
    autocmd BufEnter * call s:restore_window_view()
endif


" ---- TABLINE ---------------------------------------------------------------------------
function! MyTabLabel(tabnr) abort
    let l:bufnr = tabpagebuflist(a:tabnr)[tabpagewinnr(a:tabnr) - 1]

    let l:modified = 0
    if getbufvar(l:bufnr, '&modified')
        let l:modified = 1
    endif

    let l:tablabel = ''
    let l:custom_tablabel = gettabvar(a:tabnr, 'tablabel', '')

    if empty(l:custom_tablabel)
        let l:bufname = bufname(l:bufnr)

        if empty(l:bufname)
            let l:tablabel = empty(&buftype) ? 'No Name' : '<' . &buftype . '>'
        else
            let l:tablabel = fnamemodify(l:bufname, ':t')
        endif
    else
        let l:tablabel .= l:custom_tablabel
    endif

    if l:modified
        let l:tablabel .= '*'
    endif

    return tabpagewinnr(a:tabnr, '$') . " " . l:tablabel
endfunction

function! MyTabLine() abort
    let l:tabline = ''

    for l:num in range(1, tabpagenr('$'))
        let l:tabline .= (l:num != tabpagenr()) ? '%#TabLine#' : '%#TabLineSel#'
        let l:tabline .= '%' . l:num . 'T %{MyTabLabel(' . l:num . ')} '
    endfor

    let l:tabline .= '%#TabLineFill#%T%='
    " let l:tabline .= repeat('%#TabLine#%999X[X]', l:num > 1)
    if ProsetIsProject()
        let l:tabline .= "%#TabLine#"
        \ . "(" . ProsetGetProjectName() . ":" . ProsetGetSettingsName() . ")"
    endif

    return l:tabline
endfunction


" ---- TAB RENAME ------------------------------------------------------------------------
function! TabRename(tablabel) abort
    let t:tablabel = a:tablabel
    execute 'redrawtabline'
endfunction

function! TabRename(tabnr, tablabel) abort
    call settabvar(a:tabnr, 'tablabel', a:tablabel)
    execute 'redrawtabline'
endfunction

function! s:rename_fugitive_tabname()
    let l:cmd_name      = "basename $(git rev-parse --show-toplevel)"
    let l:cmd_branch    = "git branch --show-current"
    let l:cmd_head      = "git rev-parse --short HEAD"

    let l:name_list     = systemlist(l:cmd_name)
    let l:branch_list   = systemlist(l:cmd_branch)

    let l:name = "N/A"
    let l:branch = "N/A"

    if !empty(l:name_list)
        let l:name = l:name_list[0]
    endif

    if !empty(l:branch_list)
        let l:branch = l:branch_list[0]
    else
        let l:head = systemlist(l:cmd_head)
        if !empty(l:head)
            let l:branch = l:head[0]
        endif
    endif

    call TabRename(1, "(" . l:name . ":" . l:branch . ")")
endfunction

if exists('+showtabline')
    command! -nargs=+ TabRename call TabRename(<f-args>)
  
    set tabline=%!MyTabLine()
    augroup fugitive_tabname
        autocmd!
        autocmd User FugitiveChanged,FugitiveIndex :call <SID>rename_fugitive_tabname()
    augroup END
endif
